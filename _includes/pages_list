{% for node in pages_list %}
  {% if node.title != null %}
    {% if group == null or group == node.group %}
      <li class="post-list-entry">
        <a href="{{ node.url }}" class="post-list-link{% if page.url == node.url %} active{% endif %}">{{ node.title }}</a>
        <time class="post-list-date" datetime="{{ node.date | date: '%Y-%m-%d' }}">{{ node.date | date: '%Y-%m-%d' }}</time>
      </li>
    {% endif %}
  {% endif %}
{% endfor %}
{% assign pages_list = nil %}
{% assign group = nil %}
